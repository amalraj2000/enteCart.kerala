# Turso (https://turso.tech):  turso db create entecart && turso db show entecart --url && turso db tokens create entecart
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Random string, 32+ chars (openssl rand -base64 32). Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# The admin is a row in the users table with role = admin, created on first start from these two values.
# Sign in from the normal login modal with this email + password
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change-me

# WhatsApp alert to the owner on every new order (free CallMeBot service — see README "WhatsApp order alerts")
ADMIN_WHATSAPP=91XXXXXXXXXX
CALLMEBOT_API_KEY=

# Razorpay TEST keys (Dashboard → switch to Test Mode → Account & Settings → API Keys). Keep the secret server-side only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-key-secret

# Razorpay webhook secret (Dashboard -> Webhooks -> URL /api/payments/webhook, events payment.captured + order.paid). Records payments even if the customer closes the tab.
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-secret

# Public address of the shop (used for SEO: canonical links, sitemap, Google product data). No trailing slash.
SITE_URL=https://your-domain.com
